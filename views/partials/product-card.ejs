<div class="col-sm-3">
	<div class="single-item">
		<% if (product.tag) { %>
		<div class="ribbon-wrapper"><div class="ribbon <%= product.tag.toLowerCase() %>"><%= product.tag %></div></div>
		<% } %>
		<div class="single-item-header">
			<a href="product.html"><img src="<%= product.image %>" alt="<%= product.name %>"></a>
		</div>
		<div class="single-item-body">
			<p class="single-item-title"><%= product.name %></p>
			<p class="single-item-price">
				<% if (product.oldPrice) { %>
				<span class="flash-del">$<%= product.oldPrice.toFixed(2) %></span>
				<span class="flash-sale">$<%= product.price.toFixed(2) %></span>
				<% } else { %>
				<span>$<%= product.price.toFixed(2) %></span>
				<% } %>
			</p>
		</div>
		<div class="single-item-caption">
			<a class="add-to-cart pull-left" href="shopping_cart.html"><i class="fa fa-shopping-cart"></i></a>
			<a class="beta-btn primary" href="product.html">Details <i class="fa fa-chevron-right"></i></a>
			<div class="clearfix"></div>
		</div>
	</div>
</div>
